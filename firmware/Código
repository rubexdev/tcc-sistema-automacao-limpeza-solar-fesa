#include <WiFi.h>
#include <FirebaseESP32.h>
#include <addons/TokenHelper.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// --- CONFIGURAÇÕES DE REDE E FIREBASE ---
#define WIFI_SSID "A26"
#define WIFI_PASSWORD "santosfc"
#define FIREBASE_HOST "seu-projeto-default-rtdb.firebaseio.com"
#define FIREBASE_AUTH "lhmzy9ApZ4lCOGv8rPfDkcmLPRDzDRDEynPNGRpP"

// --- DEFINIÇÃO DOS PINOS ---
#define PIN_BTN_ACAO  5   
#define PIN_BTN_MODO  16  
#define TRIG_ESQ 4
#define ECHO_ESQ 17
#define TRIG_DIR 25
#define ECHO_DIR 2
#define M1_R_PWM 14  // Escovão
#define M1_L_PWM 13
#define M2_R_PWM 27  // Tração Esq
#define M2_L_PWM 26
#define M3_R_PWM 23  // Tração Dir
#define M3_L_PWM 33

// --- VARIÁVEIS DE SISTEMA ---
FirebaseData fbdo;
FirebaseAuth auth;
FirebaseConfig config;
LiquidCrystal_I2C lcd(0x27, 20, 4);

bool comandoIniciar = false;
String modoSistema = "automatico"; 
int ciclosRealizados = 0;
String sentidoAtual = "PARADO";
const int DISTANCIA_LIMITE = 10; 
unsigned long tempoPausaInversao = 0;
unsigned long tempoUltimaTelemetria = 0;

// Configuração PWM
const int freq = 5000;
const int res = 8;

// --- FUNÇÕES DE HARDWARE ---
long lerUltrassom(int trig, int echo) {
  digitalWrite(trig, LOW); delayMicroseconds(2);
  digitalWrite(trig, HIGH); delayMicroseconds(10);
  digitalWrite(trig, LOW);
  long duracao = pulseIn(echo, HIGH, 25000);
  long d = duracao * 0.034 / 2;
  return (d == 0) ? 400 : d;
}

// 60% de velocidade (153/255)
void acionarTracao(int vel) {
  ledcWrite(M2_R_PWM, vel); ledcWrite(M2_L_PWM, vel);
  ledcWrite(M3_R_PWM, vel); ledcWrite(M3_L_PWM, vel);
}

// 100% de velocidade (255/255)
void acionarEscova(int velR, int velL) {
  ledcWrite(M1_R_PWM, velR); ledcWrite(M1_L_PWM, velL);
}

void pararTudo() {
  acionarTracao(0); acionarEscova(0, 0);
  if (sentidoAtual != "HOMING") sentidoAtual = "PARADO";
}

void executarCicloLimpeza() {
  if (sentidoAtual == "PARADO" || sentidoAtual == "HOMING") sentidoAtual = "DIR";

  if (sentidoAtual == "DIR") {
    acionarTracao(153); acionarEscova(0, 255);
    if (lerUltrassom(TRIG_DIR, ECHO_DIR) <= DISTANCIA_LIMITE) {
      pararTudo(); sentidoAtual = "PAUSA_FIM_1"; tempoPausaInversao = millis();
    }
  } 
  else if (sentidoAtual == "PAUSA_FIM_1") {
    if (millis() - tempoPausaInversao >= 2000) {
      acionarEscova(255, 0); sentidoAtual = "PAUSA_FIM_2"; tempoPausaInversao = millis();
    }
  }
  else if (sentidoAtual == "PAUSA_FIM_2") {
    if (millis() - tempoPausaInversao >= 1000) sentidoAtual = "ESQ";
  }
  else if (sentidoAtual == "ESQ") {
    acionarTracao(153); acionarEscova(255, 0);
    if (lerUltrassom(TRIG_ESQ, ECHO_ESQ) <= DISTANCIA_LIMITE) {
      pararTudo(); sentidoAtual = "PAUSA_HOME"; tempoPausaInversao = millis();
    }
  }
  else if (sentidoAtual == "PAUSA_HOME") {
    if (millis() - tempoPausaInversao >= 1000) {
      ciclosRealizados++;
      // Usando sintaxe pública corrigida
      Firebase.setInt(fbdo, "/sistema_limpeza/telemetria/ciclos_realizados", ciclosRealizados);
      sentidoAtual = "DIR";
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(PIN_BTN_ACAO, INPUT_PULLUP);
  pinMode(PIN_BTN_MODO, INPUT_PULLUP);
  
  // PWM Attach (Core 3.0+ compativel)
  ledcAttach(M1_R_PWM, freq, res); ledcAttach(M1_L_PWM, freq, res);
  ledcAttach(M2_R_PWM, freq, res); ledcAttach(M2_L_PWM, freq, res);
  ledcAttach(M3_R_PWM, freq, res); ledcAttach(M3_L_PWM, freq, res);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  while (WiFi.status() != WL_CONNECTED) { delay(500); Serial.print("."); }

  config.host = FIREBASE_HOST;
  config.signer.tokens.legacy_token = FIREBASE_AUTH;
  Firebase.begin(&config, &auth);
  
  lcd.init(); lcd.backlight();
}

void loop() {
  unsigned long atual = millis();
  
  // Firebase Sync
  if (atual - tempoUltimaTelemetria >= 1000) {
    tempoUltimaTelemetria = atual;
    
    // Ler Comando (Sintaxe Mobizt Pública)
    if (Firebase.getBool(fbdo, "/sistema_limpeza/comandos/iniciar")) 
      comandoIniciar = fbdo.boolData();
      
    // Enviar dados
    Firebase.setInt(fbdo, "/sistema_limpeza/telemetria/heartbeat", atual / 1000);
    Firebase.setString(fbdo, "/sistema_limpeza/telemetria/sentido_movimento", sentidoAtual);
  }

  // Lógica de Execução
  if (comandoIniciar) executarCicloLimpeza(); else pararTudo();
}
